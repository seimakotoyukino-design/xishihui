.container {
  padding: 48rpx 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 36rpx;
}

.login-btn {
  margin-bottom: 32rpx;
}

.card {
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.nickname {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.meta {
  color: #6b7280;
  font-size: 24rpx;
  margin-bottom: 4rpx;
}
